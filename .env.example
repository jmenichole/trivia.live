# ── Supabase (Settings → API) ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only (web API routes + show runner). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Roles (comma-separated Supabase auth user UUIDs) ─────────────────────
# Sign in at /login, copy the "User ID" shown there.
ADMIN_USER_IDS=
# Hosts can open /host/show/<id>; admins are always hosts.
HOST_USER_IDS=

# ── Show runner ───────────────────────────────────────────────────────────
SHOW_RUNNER_POLL_MS=1000

# ── Free extra lives: rewarded ads ───────────────────────────────────────
# mock = simulated 15s ad (default in dev); gam = Google Ad Manager rewarded
# web ad (stub); none = ads off (default in production). Referrals work
# regardless.
AD_PROVIDER=mock
# For AD_PROVIDER=gam: your rewarded ad unit, e.g. /1234567/trivia_rewarded
GAM_REWARDED_AD_UNIT_PATH=
# Minimum ms between ad start and reward for GAM (server check). Default 5000.
GAM_MIN_WATCH_MS=

# ── LiveKit (hosted shows only, optional) ────────────────────────────────
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# ── TiltCheck perks (M2, not used yet) ───────────────────────────────────
TILTCHECK_PERK_API_URL=
TILTCHECK_PERK_API_KEY=
